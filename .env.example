# ═══════════════════════════════════════════════════════════════════════
# Unified AI Advisory Pipeline — .env
# ═══════════════════════════════════════════════════════════════════════

# ── ZIdentity / Zscaler SDK (all four modules use these) ─────────────────────
ZSCALER_CLIENT_ID=iq6sb4la707kn
ZSCALER_CLIENT_SECRET=your_client_secret_here
ZSCALER_VANITY_DOMAIN=tks
ZSCALER_CLOUD=zscalertwo.net

# ── AI Guard middleware ───────────────────────────────────────────────────────
AI_GUARD_URL=http://ai-guard-middleware:8000

# ── Anthropic (fallback if AI_GUARD_URL is blank) ────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Output ───────────────────────────────────────────────────────────────────
OUTPUT_DIR=/app/reports

# ── ZIA ──────────────────────────────────────────────────────────────────────
ZIA_THREAT_LOOKBACK_HRS=24
ZIA_HUNT_QUERY_FORMAT=splunk

# ── DSPM ─────────────────────────────────────────────────────────────────────
DSPM_SCAN_SOURCES=sharepoint,onedrive,s3,gcs,azure_blob
DSPM_MIN_SCORE=25

# ── ZPA ──────────────────────────────────────────────────────────────────────
ZPA_LOOKBACK_DAYS=90
ZPA_CONNECTOR_LATENCY_SLA_MS=1000
ZPA_AUTO_REVOKE_ORPHANS=false

# ── ZIdentity service account — required API scopes ──────────────────────────
# Grant in ZIdentity console under API Clients:
#   zia:read   casb:read   dspm:read   zpa:read
