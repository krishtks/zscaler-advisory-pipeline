# ═══════════════════════════════════════════════════════════════════════
# AI Guard FastAPI Middleware — .env.middleware
# These credentials live in the MIDDLEWARE container only.
# The pipeline never sees these — it only posts to AI_GUARD_URL.
# ═══════════════════════════════════════════════════════════════════════

# ── AI Guard DaS credentials ─────────────────────────────────────────────────
# API key issued in ZIdentity console under AI Security.
# Sent as: Authorization: Bearer <ZS_DAS_API_KEY>
ZS_DAS_API_KEY=your_ai_guard_api_key_here

# Full DaS inspection endpoint (US1 cloud)
ZS_DAS_URL=https://api.us1.zseclipse.net/v1/detection/execute-policy

# Policy ID to apply during inspection
ZS_DAS_POLICY_ID=1407

# Inspection timeout in seconds
ZS_DAS_TIMEOUT_SECONDS=10

# ── Anthropic ────────────────────────────────────────────────────────────────
# Middleware calls Anthropic after inspection passes
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-opus-4-6

# ── Behaviour ────────────────────────────────────────────────────────────────
# BLOCK = enforce policy (block violating requests)
# DETECT = log only, always forward to Anthropic
AI_GUARD_MODE=BLOCK

# Write inspection audit trail to JSONL file
AI_GUARD_AUDIT_LOG=true
AUDIT_LOG_PATH=/app/logs/ai_guard_audit.jsonl

# Port the middleware listens on (must match AI_GUARD_URL in pipeline .env)
PORT=8000
